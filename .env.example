# ------------------------------------------------------------------------------
# Okapi Logistics — variables d'environnement (exemple)
# Copier vers .env à la racine et dans apps/api/.env pour le développement local.
# Ne jamais committer de vraies valeurs : en production, tout vient du coffre de secrets.
# ------------------------------------------------------------------------------

NODE_ENV=development

# --- API ---
API_PORT=3000
API_BASE_URL=http://localhost:3000
PUBLIC_TRACKING_BASE_URL=http://localhost:3001

# --- Base de données (PostgreSQL 16 ; en prod : OVHcloud Managed Databases, région UE) ---
DATABASE_URL=postgresql://okapi:okapi@localhost:5432/okapi?schema=public

# --- Redis (files BullMQ + cache) ---
REDIS_URL=redis://localhost:6379

# --- Stockage objet S3-compatible (dev : MinIO ; prod : OVHcloud Object Storage UE) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-par
S3_BUCKET=okapi-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL_TTL_SECONDS=900
S3_CLIENT_URL_TTL_SECONDS=3600

# --- Authentification ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
ARGON2_MEMORY_KIB=19456

# --- Multi-devises ---
REFERENCE_CURRENCY=USD
FX_PROVIDER=exchangerate.host
FX_API_BASE=https://api.exchangerate.host
FX_API_KEY=
FX_SYNC_CRON=0 */6 * * *
FX_STALE_HOURS=36

# --- Notifications (toutes optionnelles : vide = mode "console",
#     journalisation locale, aucun envoi réel — voir
#     apps/api/src/notifications/providers/) ---
NOTIFICATIONS_DISPATCH_INTERVAL_MS=15000
NOTIFICATIONS_DISPATCH_BATCH_SIZE=20
NOTIFICATIONS_MAX_ATTEMPTS=5

# Amazon SES v2 (e-mail)
SES_REGION=
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_FROM_EMAIL=contact.gokapi@gmail.com

# Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Passerelle SMS (référence : Africa's Talking — voir docs/10 §7)
SMS_GATEWAY_URL=https://api.africastalking.com/version1/messaging
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=

# --- Divers ---
DEFAULT_LOCALE=fr
TRACKING_SEQUENCE_SCOPE=DESTINATION_CITY
DUNNING_SCHEDULE_DAYS=0,2,5
CONTACT_EMAIL=contact.gokapi@gmail.com
