# apps/api/.env — copier depuis ../../.env.example et adapter.
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000
PUBLIC_TRACKING_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

DATABASE_URL=postgresql://okapi:okapi@localhost:5432/okapi?schema=public
REDIS_URL=redis://localhost:6379

REFERENCE_CURRENCY=USD
FX_PROVIDER=exchangerate.host
FX_API_BASE=https://api.exchangerate.host
FX_STALE_HOURS=36

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

DEFAULT_LOCALE=fr
TRACKING_SEQUENCE_SCOPE=DESTINATION_CITY
CONTACT_EMAIL=contact.gokapi@gmail.com

# Jeu de données de démonstration (seed)
SEED_PASSWORD=OkapiDev!2026

# Notifications (toutes optionnelles : vide = mode "console", journalisation
# locale, aucun envoi réel — voir apps/api/src/notifications/providers/)
NOTIFICATIONS_DISPATCH_INTERVAL_MS=15000
NOTIFICATIONS_DISPATCH_BATCH_SIZE=20
NOTIFICATIONS_MAX_ATTEMPTS=5
SES_REGION=
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_FROM_EMAIL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
SMS_GATEWAY_URL=https://api.africastalking.com/version1/messaging
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=
