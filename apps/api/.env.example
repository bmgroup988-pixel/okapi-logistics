# apps/api/.env — copier depuis ../../.env.example et adapter.
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000
PUBLIC_TRACKING_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

DATABASE_URL=postgresql://okapi:okapi@localhost:5432/okapi?schema=public
REDIS_URL=redis://localhost:6379

REFERENCE_CURRENCY=USD
FX_PROVIDER=exchangerate.host
FX_API_BASE=https://api.exchangerate.host
FX_STALE_HOURS=36

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

DEFAULT_LOCALE=fr
TRACKING_SEQUENCE_SCOPE=DESTINATION_CITY
CONTACT_EMAIL=contact.gokapi@gmail.com

# Jeu de données de démonstration (seed)
SEED_PASSWORD=OkapiDev!2026
