  parcelId       String   @map("parcel_id") @db.Uuid
  storageKey     String?  @unique @map("storage_key")
  derivativeKeys Json?    @map("derivative_keys")
  sha256         String   @db.Char(64)
  bytes          Int
  mimeType       String   @map("mime_type")
  width          Int?
  height         Int?
  isPrimary      Boolean  @default(false) @map("is_primary")
  takenById      String   @map("taken_by") @db.Uuid
  takenAt        DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)
  exifStripped   Boolean  @default(false) @map("exif_stripped")
  locked         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parcel  Parcel @relation(fields: [parcelId], references: [id])
  takenBy User   @relation(fields: [takenById], references: [id])

  @@index([parcelId])
  @@map("parcel_photos")
}

model ParcelEvent {
  id              String       @id @default(uuid()) @db.Uuid
  parcelId        String       @map("parcel_id") @db.Uuid
  status          ParcelStatus
  locationCityId  String?      @map("location_city_id") @db.Uuid
  locationLabel   String?      @map("location_label")
  note            String?
  visibleToClient Boolean      @default(true) @map("visible_to_client")
  createdById     String?      @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  parcel       Parcel @relation(fields: [parcelId], references: [id])
  createdBy    User?  @relation(fields: [createdById], references: [id])
  locationCity City?  @relation("EventLocationCity", fields: [locationCityId], references: [id])

  @@index([parcelId, createdAt])
  @@map("parcel_events")
}

// ============================================ Paiement & facturation
model Payment {
  id                      String        @id @default(uuid()) @db.Uuid
  parcelId                String        @map("parcel_id") @db.Uuid
  amount                  Decimal       @db.Decimal(18, 4)
  currency                String        @db.Char(3)
  amountInBillingCurrency Decimal       @map("amount_in_billing_currency") @db.Decimal(18, 4)
  billingCurrency         String        @map("billing_currency") @db.Char(3)
  amountReference         Decimal       @map("amount_reference") @db.Decimal(18, 4)
  referenceCurrency       String        @map("reference_currency") @db.Char(3)
  fxRate                  Decimal       @map("fx_rate") @db.Decimal(18, 8)
  fxRateToBilling         Decimal       @map("fx_rate_to_billing") @db.Decimal(18, 8)
  exchangeRateId          String?       @map("exchange_rate_id") @db.Uuid
  method                  PaymentMethod
  mobileMoneyProvider     String?       @map("mobile_money_provider")
  externalRef             String?       @map("external_ref")
  state                   PaymentState  @default(EN_ATTENTE)
  confirmedAt             DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  failureReason           String?       @map("failure_reason")
  refundOfPaymentId       String?       @map("refund_of_payment_id") @db.Uuid
  refundReason            String?       @map("refund_reason")
  collectedById           String        @map("collected_by") @db.Uuid
  agencyId                String        @map("agency_id") @db.Uuid
  countryId               String        @map("country_id") @db.Uuid
  receivedAt              DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
  idempotencyKey          String?       @map("idempotency_key")
  createdById             String?       @map("created_by") @db.Uuid
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  parcel      Parcel         @relation(fields: [parcelId], references: [id])
  collectedBy User           @relation("PaymentCollectedBy", fields: [collectedById], references: [id])
  agency      Agency         @relation(fields: [agencyId], references: [id])
  refundOf    Payment?       @relation("PaymentRefund", fields: [refundOfPaymentId], references: [id])
  refunds     Payment[]      @relation("PaymentRefund")
  invoices    Invoice[]
  documents   DocumentFile[]

  @@index([parcelId, receivedAt])
  @@index([agencyId, receivedAt])
  @@index([countryId, receivedAt])
  @@index([state])
  @@index([method])
  @@map("payments")
}

model Invoice {
  id                    String       @id @default(uuid()) @db.Uuid
  parcelId              String       @map("parcel_id") @db.Uuid
  type                  DocumentType
  number                String
  countryId             String       @map("country_id") @db.Uuid
  paymentId             String?      @map("payment_id") @db.Uuid
  amountNet             Decimal      @map("amount_net") @db.Decimal(18, 4)
  amountTax             Decimal      @default(0) @map("amount_tax") @db.Decimal(18, 4)
  amountGross           Decimal      @map("amount_gross") @db.Decimal(18, 4)
  currency              String       @db.Char(3)
  amountReference       Decimal      @map("amount_reference") @db.Decimal(18, 4)
  referenceCurrency     String       @map("reference_currency") @db.Char(3)
  fxRate                Decimal      @map("fx_rate") @db.Decimal(18, 8)
  issuedAt              DateTime     @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById            String?      @map("issued_by") @db.Uuid
  legalMentionsSnapshot Json         @map("legal_mentions_snapshot")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  parcel    Parcel         @relation(fields: [parcelId], references: [id])
  payment   Payment?       @relation(fields: [paymentId], references: [id])
  documents DocumentFile[]

  @@unique([countryId, type, number])
  @@index([parcelId])
  @@map("invoices")
}

model DocumentFile {
  id             String       @id @default(uuid()) @db.Uuid
  parcelId       String       @map("parcel_id") @db.Uuid
  paymentId      String?      @map("payment_id") @db.Uuid
  invoiceId      String?      @map("invoice_id") @db.Uuid
  type           DocumentType
  storageKey     String       @unique @map("storage_key")
  number         String?
  checksumSha256 String?      @map("checksum_sha256") @db.Char(64)
  generatedAt    DateTime     @default(now()) @map("generated_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  parcel  Parcel   @relation(fields: [parcelId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([parcelId])
  @@map("documents")
}

// ============================================================ Notifications
model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  parcelId          String?             @map("parcel_id") @db.Uuid
  trigger           NotificationTrigger
  channel           NotificationChannel
  templateId        String?             @map("template_id") @db.Uuid
  locale            String
  recipient         String
  subject           String?
  bodyPreview       String?             @map("body_preview")
  status            NotificationStatus  @default(FILE)
  provider          String?
  providerMessageId String?             @map("provider_message_id")
  error             String?
  attempts          Int                 @default(0) @db.SmallInt
  scheduledFor      DateTime?           @map("scheduled_for") @db.Timestamptz(6)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  parcel   Parcel?               @relation(fields: [parcelId], references: [id])
  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([parcelId, createdAt])
  @@index([status, scheduledFor])
  @@map("notifications")
}

// ============================================ Séquences & numérotation
