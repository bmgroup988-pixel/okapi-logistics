/// Partenaire de livraison tiers pour une ville PARTNER — addendum 08, §1.4.
/// Plusieurs partenaires actifs peuvent desservir la même ville, chacun avec
/// sa propre zone de couverture et son propre tarif (PartnerTariff).
model DeliveryPartner {
  id              String         @id @default(uuid()) @db.Uuid
  cityId          String         @map("city_id") @db.Uuid
  city            City           @relation(fields: [cityId], references: [id])
  name            String
  coverageZone    String?        @map("coverage_zone")
  contactName     String?        @map("contact_name")
  contactPhone    String?        @map("contact_phone")
  contactEmail    String?        @map("contact_email")
  commissionPct   Decimal?       @map("commission_pct") @db.Decimal(6, 4)
  /// PER_KG ou PERCENT_COLLECTED — détermine le calcul de PartnerSettlement.
  settlementMode  SettlementMode @default(PER_KG) @map("settlement_mode")
  reliabilityNote String?        @map("reliability_note")
  /// Partenaire proposé par défaut à la création d'un colis pour cette ville.
  isPreferred     Boolean        @default(false) @map("is_preferred")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tariffs     PartnerTariff[]
  settlements PartnerSettlement[]
  parcels     Parcel[]

  @@index([cityId, isActive])
  @@map("delivery_partners")
}

/// Tarif de la dernière étape (hub → destinataire) d'un partenaire —
/// addendum 08, §1.5. Distinct de `Tariff`/RouteTariff, qui couvre le trajet
/// principal jusqu'au hub le plus proche.
model PartnerTariff {
  id                String          @id @default(uuid()) @db.Uuid
  deliveryPartnerId String          @map("delivery_partner_id") @db.Uuid
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])
  pricePerKg        Decimal         @map("price_per_kg") @db.Decimal(18, 4)
  currencyCode      String          @map("currency_code") @db.Char(3)
  currency          Currency        @relation(fields: [currencyCode], references: [code])
  minWeightKg       Decimal?        @map("min_weight_kg") @db.Decimal(10, 2)
  isActive          Boolean         @default(true) @map("is_active")
  effectiveFrom     DateTime        @default(now()) @map("effective_from") @db.Date
  effectiveTo       DateTime?       @map("effective_to") @db.Date
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([deliveryPartnerId, isActive, effectiveFrom])
  @@map("partner_tariffs")
}

/// Réconciliation périodique des commissions dues à un partenaire —
/// addendum 08, §5.
model PartnerSettlement {
  id                   String           @id @default(uuid()) @db.Uuid
  deliveryPartnerId    String           @map("delivery_partner_id") @db.Uuid
  deliveryPartner      DeliveryPartner  @relation(fields: [deliveryPartnerId], references: [id])
  periodStart          DateTime         @map("period_start") @db.Date
  periodEnd            DateTime         @map("period_end") @db.Date
  parcelCount          Int              @map("parcel_count")
  totalCollectedAmount Decimal          @map("total_collected_amount") @db.Decimal(18, 4)
  commissionAmount     Decimal          @map("commission_amount") @db.Decimal(18, 4)
  currencyCode         String           @map("currency_code") @db.Char(3)
  currency             Currency         @relation(fields: [currencyCode], references: [code])
  status               SettlementStatus @default(DRAFT)
  validatedByUserId    String?          @map("validated_by_user_id") @db.Uuid
  paidAt               DateTime?        @map("paid_at") @db.Timestamptz(6)
  paymentReference     String?          @map("payment_reference")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([deliveryPartnerId, periodStart, periodEnd])
  @@map("partner_settlements")
}

// ============================================ Module fournisseurs (docs/11)

/// Fournisseur externe confiant des colis groupés en expéditions — docs/11, §1/§2.1.
model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  /// Identifiant anti-fraude attribué par le système (FRN-XXXXXX) — docs/11, §1.
  code            String   @unique
  name            String
  contactName     String?  @map("contact_name")
  contactPhone    String?  @map("contact_phone")
  contactEmail    String?  @map("contact_email")
  address         String?
  countryId       String   @map("country_id") @db.Uuid
  defaultAgencyId String   @map("default_agency_id") @db.Uuid
  billingCurrency String   @map("billing_currency") @db.Char(3)
  /// Compte de connexion au portail fournisseur — docs/11, §5. Null tant que non activé.
  userId          String?  @unique @map("user_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  createdById     String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  country        Country           @relation(fields: [countryId], references: [id])
  defaultAgency  Agency            @relation(fields: [defaultAgencyId], references: [id])
  currency       Currency          @relation(fields: [billingCurrency], references: [code])
  user           User?             @relation(fields: [userId], references: [id])
  userRoleScopes UserRole[]
  shipments      Shipment[]
  parcels        Parcel[]
  invoices       SupplierInvoice[]

  @@index([countryId])
  @@map("suppliers")
}

/// Expédition groupée : plusieurs colis, un client final différent chacun,
/// facturés en une seule fois au fournisseur à la clôture — docs/11, §2.2.
model Shipment {
  id                      String         @id @default(uuid()) @db.Uuid
  /// EXP-AAMM-NNNN, séquentiel par fournisseur/mois — docs/11, §3.
  code                    String         @unique
  supplierId              String         @map("supplier_id") @db.Uuid
  originAgencyId          String         @map("origin_agency_id") @db.Uuid
  status                  ShipmentStatus @default(OUVERTE)
  /// Dénormalisé pour l'affichage — la source de vérité reste COUNT(parcels) à la clôture (docs/11 §4.2).
  parcelCount             Int            @default(0) @map("parcel_count")
  totalWeightKg           Decimal        @default(0) @map("total_weight_kg") @db.Decimal(10, 2)
  currency                String         @db.Char(3)
  totalAmountDue          Decimal        @default(0) @map("total_amount_due") @db.Decimal(18, 4)
  referenceCurrency       String         @default("USD") @map("reference_currency") @db.Char(3)
  totalAmountDueReference Decimal        @default(0) @map("total_amount_due_reference") @db.Decimal(18, 4)
  openedById              String?        @map("opened_by") @db.Uuid
  closedById              String?        @map("closed_by") @db.Uuid
  openedAt                DateTime       @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt                DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier     Supplier         @relation(fields: [supplierId], references: [id])
  originAgency Agency           @relation(fields: [originAgencyId], references: [id])
  parcels      Parcel[]
  invoice      SupplierInvoice?

  @@index([supplierId, status, openedAt])
  @@map("shipments")
}

/// Groupage de transit — colis walk-in et/ou fournisseur regroupés pour un
/// même trajet, uniquement pour le suivi logistique (quels colis du lot sont
/// arrivés vs pas encore). Sans lien avec la facturation, déjà réglée par
/// colis à l'enregistrement (`Parcel.amountDue`) — contrairement à
/// `Shipment`, un `Groupage` ne génère jamais de facture.
///
/// Organisé par agence de DESTINATION (pas de départ) — décision purement
/// administrative : un colis peut être intégré à un groupage dont la
/// destination diffère de la sienne propre (ex. un colis à destination de
/// Lubumbashi ajouté au groupage FIH pour combler un vide ou une urgence),
/// sans que cela n'affecte jamais `Parcel.destinationCityId` ni son propre
/// numéro de suivi — demande produit du 2026-09-22.
model Groupage {
  id                  String         @id @default(uuid()) @db.Uuid
  /// GRP-AAMM-NNNN, séquentiel global mensuel.
  code                String         @unique
  destinationAgencyId String         @map("destination_agency_id") @db.Uuid
  status              GroupageStatus @default(OUVERT)
  /// Dénormalisé pour l'affichage — source de vérité = COUNT(parcels).
  parcelCount         Int            @default(0) @map("parcel_count")
  totalWeightKg       Decimal        @default(0) @map("total_weight_kg") @db.Decimal(10, 2)
  note                String?
  openedById          String?        @map("opened_by") @db.Uuid
  closedById          String?        @map("closed_by") @db.Uuid
  openedAt            DateTime       @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt            DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  destinationAgency Agency   @relation(fields: [destinationAgencyId], references: [id])
  parcels           Parcel[]

  @@index([status, openedAt])
  @@map("groupages")
}

/// Facture unique adressée au fournisseur à la clôture d'une expédition —
/// une ligne par client final (docs/11, §2.4/§4).
model SupplierInvoice {
  id                    String   @id @default(uuid()) @db.Uuid
  shipmentId            String   @unique @map("shipment_id") @db.Uuid
  supplierId            String   @map("supplier_id") @db.Uuid
  /// FACT-{code fournisseur}-AAMM-NNNN — docs/11, §3.
  number                String   @unique
  currency              String   @db.Char(3)
  amountGross           Decimal  @map("amount_gross") @db.Decimal(18, 4)
  referenceCurrency     String   @map("reference_currency") @db.Char(3)
  amountReference       Decimal  @map("amount_reference") @db.Decimal(18, 4)
  fxRate                Decimal  @map("fx_rate") @db.Decimal(18, 8)
  issuedAt              DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById            String?  @map("issued_by") @db.Uuid
  storageKey            String?  @map("storage_key")
  legalMentionsSnapshot Json     @map("legal_mentions_snapshot")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment Shipment              @relation(fields: [shipmentId], references: [id])
  supplier Supplier              @relation(fields: [supplierId], references: [id])
  lines    SupplierInvoiceLine[]

  @@index([supplierId, issuedAt])
  @@map("supplier_invoices")
}

/// Une ligne par colis/client final — instantané figé au moment de la
/// clôture, indépendant de toute modification ultérieure du contact
/// (docs/11, §2.5).
model SupplierInvoiceLine {
  id                   String   @id @default(uuid()) @db.Uuid
  supplierInvoiceId    String   @map("supplier_invoice_id") @db.Uuid
  parcelId             String   @unique @map("parcel_id") @db.Uuid
  trackingNumber       String   @map("tracking_number")
  recipientName        String   @map("recipient_name")
  recipientPhone       String?  @map("recipient_phone")
  destinationCityLabel String   @map("destination_city_label")
  weightKg             Decimal  @map("weight_kg") @db.Decimal(10, 2)
  amount               Decimal  @db.Decimal(18, 4)
  currency             String   @db.Char(3)
  amountReference      Decimal  @map("amount_reference") @db.Decimal(18, 4)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  parcel          Parcel          @relation(fields: [parcelId], references: [id])

  @@index([supplierInvoiceId])
  @@map("supplier_invoice_lines")
}

// ============================================ Compagnies de transport
/// Compagnie avec laquelle Okapi Logistics sous-traite le transport principal
/// (aérien/maritime) — distincte du `DeliveryPartner` (dernier kilomètre).
/// Gérée uniquement par le super-admin ; visible en lecture par tout le
/// personnel interne (agent, DAF, super-admin) au moment de l'expédition.
model Carrier {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  contactEmail String?  @map("contact_email")
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parcels Parcel[]

  @@map("carriers")
}
