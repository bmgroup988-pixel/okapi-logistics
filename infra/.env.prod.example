# Copier vers infra/.env.prod et remplir — NE JAMAIS committer .env.prod
# (déjà exclu via .gitignore). Voir docs/10-guide-hebergement-ovhcloud.md.

# Image Docker — <owner>/<repo> en minuscules, ex. ghcr.io/bmgroup988-pixel/okapi-logistics
GHCR_IMAGE_PREFIX=ghcr.io/votre-compte/okapi-logistics

# Domaines (DNS déjà pointés vers l'IP du serveur — voir docs/10 §3)
API_DOMAIN=api.okapilogistics.com
BACKOFFICE_DOMAIN=admin.okapilogistics.com
SUIVI_DOMAIN=suivi.okapilogistics.com
ACME_EMAIL=contact.gokapi@gmail.com

# Base de données — générer un mot de passe fort (ex. openssl rand -base64 24)
POSTGRES_USER=okapi
POSTGRES_PASSWORD=CHANGEZ_MOI

# Object Storage (MinIO auto-hébergé par défaut ; identifiants forts requis
# dès la production — remplacer par OVHcloud Object Storage plus tard sans
# changer de code, voir docs/10 §6)
S3_ACCESS_KEY=CHANGEZ_MOI
S3_SECRET_KEY=CHANGEZ_MOI

# Secrets JWT — générer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGEZ_MOI
JWT_REFRESH_SECRET=CHANGEZ_MOI

CONTACT_EMAIL=contact.gokapi@gmail.com

# --- Connecteurs de notification (optionnels) ---------------------------
# Laisser vide = mode "console" (journalisation locale, aucun envoi réel).
SES_REGION=
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_FROM_EMAIL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_API_KEY=
